// =====================================================================
// ĐỀ TÀI: TRÌNH ĐÁNH GIÁ & CHUYỂN ĐỔI BIỂU THỨC TOÁN HỌC
// Chức năng: Infix -> Postfix (Shunting-yard), Infix -> Prefix, LaTeX,
//            Tính giá trị (có biến, hàm), vẽ cây biểu thức, lưu lịch sử.
// Cấu trúc dữ liệu: Stack (tự cài bằng danh sách liên kết), Cây nhị phân.
// =====================================================================
#include <iostream>
#include <string>
#include <vector>
#include <map>
#include <cmath>
#include <cctype>
#include <cstring>
#include <fstream>
#include <sstream>
#include <stdexcept>
#include <iomanip>
using namespace std;

const double PI_V = 3.14159265358979323846;
const double E_V  = 2.71828182845904523536;

// ---------------------------------------------------------------------
// 1. NGĂN XẾP (STACK) TỰ CÀI ĐẶT BẰNG DANH SÁCH LIÊN KẾT ĐƠN
// ---------------------------------------------------------------------
template <typename T>
class Stack {
    struct Node { T data; Node* next; };
    Node* topPtr = nullptr;
    size_t n = 0;
public:
    Stack() = default;
    Stack(const Stack&) = delete;
    Stack& operator=(const Stack&) = delete;
    ~Stack() { while (!empty()) pop(); }

    void push(const T& v) { topPtr = new Node{v, topPtr}; ++n; }
    void pop() {
        if (empty()) throw runtime_error("Stack rong");
        Node* t = topPtr; topPtr = topPtr->next; delete t; --n;
    }
    T& top() {
        if (empty()) throw runtime_error("Stack rong");
        return topPtr->data;
    }
    bool empty() const { return topPtr == nullptr; }
    size_t size() const { return n; }

    // In nội dung ngăn xếp (đáy -> đỉnh) phục vụ minh họa từng bước
    string toString() const {
        vector<T> v;
        for (Node* p = topPtr; p; p = p->next) v.push_back(p->data);
        ostringstream os; os << setprecision(10) << "[";
        for (size_t i = v.size(); i-- > 0;) { os << v[i]; if (i) os << ", "; }
        os << "]";
        return os.str();
    }
};

// ---------------------------------------------------------------------
// 2. TOKEN & BỘ TÁCH TOKEN (LEXER)
// ---------------------------------------------------------------------
enum class TokType { NUM, VAR, OP, FUNC, LP, RP };
struct Token {
    TokType type;
    string text;
    double value = 0;
};

string fmt(double v) { ostringstream os; os << setprecision(10) << v; return os.str(); }
string showName(const Token& t) { return t.text == "~" ? "neg" : t.text; }

bool isFunction(const string& s) {
    static const char* fn[] = {"sin","cos","tan","sqrt","log","ln","abs","exp"};
    for (auto f : fn) if (s == f) return true;
    return false;
}
int  prec(const string& op) {
    if (op == "+" || op == "-") return 1;
    if (op == "*" || op == "/" || op == "%") return 2;
    if (op == "~") return 3;           // âm một ngôi
    if (op == "^") return 4;
    return 0;
}
bool rightAssoc(const string& op) { return op == "^" || op == "~"; }

vector<Token> tokenize(const string& s) {
    vector<Token> out;
    size_t i = 0;
    while (i < s.size()) {
        char c = s[i];
        if (isspace((unsigned char)c)) { i++; continue; }
        if (isdigit((unsigned char)c) || c == '.') {
            size_t j = i; int dots = 0;
            while (j < s.size() && (isdigit((unsigned char)s[j]) || s[j] == '.')) {
                if (s[j] == '.') dots++;
                j++;
            }
            string num = s.substr(i, j - i);
            if (dots > 1 || num == ".") throw runtime_error("So khong hop le: " + num);
            out.push_back({TokType::NUM, num, stod(num)});
            i = j;
        } else if (isalpha((unsigned char)c)) {
            size_t j = i;
            while (j < s.size() && (isalnum((unsigned char)s[j]) || s[j] == '_')) j++;
            string name = s.substr(i, j - i);
            out.push_back({isFunction(name) ? TokType::FUNC : TokType::VAR, name, 0});
            i = j;
        } else if (c == '(') { out.push_back({TokType::LP, "(", 0}); i++; }
        else if (c == ')')   { out.push_back({TokType::RP, ")", 0}); i++; }
        else if (strchr("+-*/%^", c)) {
            // Dấu +/- đứng đầu, sau toán tử hoặc sau '(' là toán tử MỘT NGÔI
            bool unary = out.empty() || out.back().type == TokType::OP ||
                         out.back().type == TokType::LP;
            if (unary && c == '+') { i++; continue; }          // +x == x
            out.push_back({TokType::OP, (unary && c == '-') ? string("~") : string(1, c), 0});
            i++;
        } else throw runtime_error(string("Ky tu khong hop le: ") + c);
    }
    return out;
}
// ---------------------------------------------------------------------
// 3. THUẬT TOÁN SHUNTING-YARD: INFIX -> POSTFIX
// ---------------------------------------------------------------------
vector<Token> toPostfix(const vector<Token>& tk) {
    vector<Token> out;
    Stack<Token> st;
    for (const Token& t : tk) {
        switch (t.type) {
        case TokType::NUM: case TokType::VAR: out.push_back(t); break;
        case TokType::FUNC: st.push(t); break;
        case TokType::OP:
            if (t.text != "~") {   // toán tử một ngôi tiền tố chỉ push, không pop
                while (!st.empty() &&
                       (st.top().type == TokType::FUNC ||
                        (st.top().type == TokType::OP &&
                         (prec(st.top().text) > prec(t.text) ||
                          (prec(st.top().text) == prec(t.text) && !rightAssoc(t.text)))))) {
                    out.push_back(st.top()); st.pop();
                }
            }
            st.push(t); break;
        case TokType::LP: st.push(t); break;
        case TokType::RP:
            while (!st.empty() && st.top().type != TokType::LP) { out.push_back(st.top()); st.pop(); }
            if (st.empty()) throw runtime_error("Thieu dau '(' tuong ung");
            st.pop();                                   // bỏ '('
            if (!st.empty() && st.top().type == TokType::FUNC) { out.push_back(st.top()); st.pop(); }
            break;
        }
    }
    while (!st.empty()) {
        if (st.top().type == TokType::LP) throw runtime_error("Thieu dau ')' tuong ung");
        out.push_back(st.top()); st.pop();
    }
    return out;
}
// ---------------------------------------------------------------------
// 4. TÍNH GIÁ TRỊ BIỂU THỨC HẬU TỐ (CÓ IN TỪNG BƯỚC)
// ---------------------------------------------------------------------
double applyBinary(const string& op, double a, double b) {
    if (op == "+") return a + b;
    if (op == "-") return a - b;
    if (op == "*") return a * b;
    if (op == "/") { if (fabs(b) < 1e-12) throw runtime_error("Chia cho 0"); return a / b; }
    if (op == "%") { if (fabs(b) < 1e-12) throw runtime_error("Chia lay du cho 0"); return fmod(a, b); }
    if (op == "^") return pow(a, b);
    throw runtime_error("Toan tu la: " + op);
}
double applyFunc(const string& f, double x) {
    if (f == "sin") return sin(x);
    if (f == "cos") return cos(x);
    if (f == "tan") return tan(x);
    if (f == "abs") return fabs(x);
    if (f == "exp") return exp(x);
    if (f == "sqrt") { if (x < 0) throw runtime_error("sqrt cua so am"); return sqrt(x); }
    if (f == "ln" || f == "log") { if (x <= 0) throw runtime_error("log cua so <= 0"); return f == "ln" ? log(x) : log10(x); }
    throw runtime_error("Ham la: " + f);
}

double evalPostfix(const vector<Token>& pf, const map<string,double>& vars, bool trace) {
    Stack<double> st;
    if (trace) cout << left << setw(8) << "Token" << setw(34) << "Hanh dong" << "Ngan xep\n"
                    << string(70, '-') << "\n";
    for (const Token& t : pf) {
        string act;
        if (t.type == TokType::NUM) { st.push(t.value); act = "Day so " + t.text; }
        else if (t.type == TokType::VAR) {
            auto it = vars.find(t.text);
            if (it == vars.end()) throw runtime_error("Bien chua gan gia tri: " + t.text);
            st.push(it->second); act = "Thay " + t.text + " = " + fmt(it->second);
        } else {
            bool unary = (t.text == "~") || t.type == TokType::FUNC;
            if (st.size() < (unary ? 1u : 2u)) throw runtime_error("Thieu toan hang");
            double b = st.top(); st.pop(); double r;
            if (unary) {
                r = (t.text == "~") ? -b : applyFunc(t.text, b);
                act = showName(t) + "(" + fmt(b) + ") = " + fmt(r);
            } else {
                double a = st.top(); st.pop();
                r = applyBinary(t.text, a, b);
                act = fmt(a) + " " + t.text + " " + fmt(b) + " = " + fmt(r);
            }
            st.push(r);
        }
        if (trace) cout << left << setw(8) << showName(t) << setw(34) << act << st.toString() << "\n";
    }
    if (st.size() != 1) throw runtime_error("Bieu thuc khong hop le (thua toan hang)");
    return st.top();
}
// 5. CÂY BIỂU THỨC (CÂY NHỊ PHÂN) VÀ CÁC PHÉP DUYỆT
// ---------------------------------------------------------------------
struct TNode {
    Token t; TNode *l = nullptr, *r = nullptr;
    explicit TNode(const Token& tk) : t(tk) {}
};
void freeTree(TNode* n) { if (!n) return; freeTree(n->l); freeTree(n->r); delete n; }

TNode* buildTree(const vector<Token>& pf) {
    Stack<TNode*> st;
    auto fail = [&](const string& msg) {
        while (!st.empty()) { freeTree(st.top()); st.pop(); }
        throw runtime_error(msg);
    };
    for (const Token& t : pf) {
        TNode* n = new TNode(t);
        if (t.type == TokType::NUM || t.type == TokType::VAR) { st.push(n); continue; }
        bool unary = (t.text == "~") || t.type == TokType::FUNC;
        if (st.size() < (unary ? 1u : 2u)) { delete n; fail("Thieu toan hang"); }
        if (!unary) { n->r = st.top(); st.pop(); }
        n->l = st.top(); st.pop();
        st.push(n);
    }
    if (st.size() != 1) fail("Bieu thuc khong hop le");
    return st.top();
}

int nodePrec(const TNode* n) {
    return (n->t.type == TokType::OP) ? prec(n->t.text) : 5;   // lá, hàm: ưu tiên cao nhất
}
bool needParens(int childPrec, const string& parentOp, bool isRight) {
    if (parentOp.empty()) return false;
    int pp = prec(parentOp);
    if (childPrec > pp) return false;
    if (childPrec < pp) return true;
    return isRight ? !rightAssoc(parentOp) : rightAssoc(parentOp);
}

// Cây -> Trung tố (chỉ thêm ngoặc khi cần thiết)
string toInfix(const TNode* n, const string& parentOp = "", bool isRight = false) {
    string s;
    if (n->t.type == TokType::NUM || n->t.type == TokType::VAR) return n->t.text;
    if (n->t.type == TokType::FUNC) return n->t.text + "(" + toInfix(n->l) + ")";
    if (n->t.text == "~") s = "-" + toInfix(n->l, "~", false);
    else s = toInfix(n->l, n->t.text, false) + " " + n->t.text + " " + toInfix(n->r, n->t.text, true);
    return needParens(nodePrec(n), parentOp, isRight) ? "(" + s + ")" : s;
}
// Duyệt NLR -> Tiền tố
void toPrefix(const TNode* n, vector<string>& out) {
    if (!n) return;
    out.push_back(showName(n->t));
    toPrefix(n->l, out); toPrefix(n->r, out);
}
// Cây -> LaTeX
string toLatex(const TNode* n, const string& parentOp = "", bool isRight = false) {
    const Token& t = n->t;
    if (t.type == TokType::NUM) return t.text;
    if (t.type == TokType::VAR) return t.text == "pi" ? "\\pi" : t.text;
    if (t.type == TokType::FUNC) {
        string in = toLatex(n->l);
        if (t.text == "sqrt") return "\\sqrt{" + in + "}";
        if (t.text == "abs")  return "\\left|" + in + "\\right|";
        return "\\" + (t.text == "log" ? string("log") : t.text) + "\\left(" + in + "\\right)";
    }
    string s;
    if (t.text == "~") s = "-" + toLatex(n->l, "~", false);
    else if (t.text == "/") s = "\\frac{" + toLatex(n->l) + "}{" + toLatex(n->r) + "}";
    else if (t.text == "^") s = toLatex(n->l, "^", false) + "^{" + toLatex(n->r) + "}";
    else {
        string op = t.text == "*" ? " \\cdot " : (t.text == "%" ? " \\bmod " : " " + t.text + " ");
        s = toLatex(n->l, t.text, false) + op + toLatex(n->r, t.text, true);
    }
    int cp = nodePrec(n);
    if (t.text == "/" && !(parentOp == "^" && !isRight)) cp = 5;   // \frac tự đóng gói
    return needParens(cp, parentOp, isRight) ? "(" + s + ")" : s;
}
// Vẽ cây xoay ngang: gốc bên trái, con phải ở trên, con trái ở dưới
void printTree(const TNode* n, int depth = 0) {
    if (!n) return;
    printTree(n->r, depth + 1);
    cout << string(depth * 6, ' ') << "[" << showName(n->t) << "]\n";
    printTree(n->l, depth + 1);
}
int treeHeight(const TNode* n) { return n ? 1 + max(treeHeight(n->l), treeHeight(n->r)) : 0; }
